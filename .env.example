# Copy to .env for local development
PORT=3000
DATA_DIR=./data
# Optional: override the database file location directly
# DB_PATH=./data/focusdesk.db

# Production on Render (free): create a free database at https://dashboard.turso.tech
# (sign up with GitHub, "Create Database"), then set these two values —
# Render's Blueprint deploy will prompt for them.
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_TOKEN=your-turso-token
